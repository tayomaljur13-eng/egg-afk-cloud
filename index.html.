
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Egg AFK Cloud</title>
  <style>
    body {
      margin: 0;
      padding: 24px;
      background: #101522;
      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
    }
    .card {
      max-width: 420px;
      margin: 60px auto;
      padding: 24px;
      background: #1c2638;
      border-radius: 18px;
    }
    button {
      display: block;
      width: 100%;
      margin-top: 14px;
      padding: 14px;
      border: 0;
      border-radius: 10px;
      background: #6c63ff;
      color: white;
      font-size: 16px;
    }
    p { color: #cbd5e1; }
  </style>
</head>
<body>
  <div class="card">
    <h1>🥚 Egg AFK Cloud</h1>
    <p>Your cloud dashboard prototype</p>
    <p id="status">Status: No cloud server connected</p>
    <button onclick="checkStatus()">Check Status</button>
    <button onclick="openRoblox()">Open Roblox Website</button>
  </div>

  <script>
    function checkStatus() {
      document.getElementById("status").textContent =
        "Status: Waiting for cloud server setup";
    }

    function openRoblox() {
      window.open("https://www.roblox.com/", "_blank");
    }
  </script>
</body>
</html>
